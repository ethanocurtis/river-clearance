# Copy to .env and adjust. server.js reads these via process.env -- if you're
# not using a process manager that loads .env automatically (pm2, docker
# compose, systemd EnvironmentFile), export them yourself or add a loader.

PORT=8787

# Where sqlite writes its file. Defaults to ./data/sync.sqlite3 if unset.
DB_PATH=/var/lib/river-clearance/sync.sqlite3

# Comma-separated list of origins allowed to call this API, e.g.:
#   ALLOWED_ORIGINS=https://your-domain.example
# Leave as * only while you're still figuring out your real frontend origin,
# or if you're using STATIC_DIR below (same-origin means CORS doesn't apply
# anyway).
ALLOWED_ORIGINS=*

# Set to /site to also serve the static docs/ folder from this same process
# -- frontend and API become same-origin, no CORS needed at all. Leave unset
# for an API-only deployment (e.g. frontend still on GitHub Pages elsewhere).
# In Docker this path is fixed by docker-compose.yml's bind mount; only
# change it there, not here, unless you also change the mount target.
STATIC_DIR=
