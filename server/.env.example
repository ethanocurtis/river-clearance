# Copy to .env and adjust. server.js reads these via process.env.

PORT=8787

# Where sqlite writes its file. Defaults to ./data/sync.sqlite3 if unset.
DB_PATH=/var/lib/river-clearance/sync.sqlite3

# Comma-separated list of origins allowed to call this API, e.g.:
#   ALLOWED_ORIGINS=https://your-domain.example
# Leave as * if you're serving the frontend from this same process
# (STATIC_DIR below) -- same-origin means CORS doesn't really apply anyway.
ALLOWED_ORIGINS=*

# Set to /site to also serve the static docs/ folder from this same process
# -- frontend and API become same-origin. Leave unset for an API-only
# deployment. In Docker this path is fixed by docker-compose.yml's bind
# mount; only change it there, not here, unless you also change the mount.
STATIC_DIR=

# Where docs/data/bridges.json and gauges.json live, for the admin
# data-editing API. Defaults to STATIC_DIR/data if STATIC_DIR is set above,
# so you usually don't need to set this separately.
DATA_DIR=

# ***REQUIRED*** for email verification/reset links to work -- the public
# URL this site is actually reachable at, no trailing slash:
APP_BASE_URL=https://your-domain.example

# Comma-separated emails that get the admin role automatically on signup
# (case-insensitive). Sign up with one of these to become the first admin --
# no separate "create admin" step needed.
ADMIN_EMAILS=you@your-domain.example

# --- SMTP (e.g. MXroute) -- required for verification/password-reset emails
# to actually send. Without these set, emails are only logged to the
# console, which is fine for local testing but means real signups can't
# verify their account.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="River Clearance <no-reply@your-domain.example>"

# Session cookies are `secure` (HTTPS-only) by default. Only set this to
# false for local http:// testing -- never in production.
COOKIE_SECURE=true

# --- Auto-commit + push admin data edits to GitHub -- both required to
# enable it; see "Auto-committing admin edits to GitHub" in README.md. Leave
# both blank to keep admin saves file-only (no git involved). In Docker,
# REPO_DIR is fixed by docker-compose.yml's bind mount (/repo); only change
# it there, not here, unless you also change the mount.
REPO_DIR=
GIT_PUSH_TOKEN=
GIT_COMMIT_NAME=River Clearance Admin
GIT_COMMIT_EMAIL=admin@your-domain.example
